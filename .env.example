OPENAI_API_KEY=your_openai_api_key_here

DATABASE_URL=postgresql+psycopg://booksearch:booksearch@localhost:5432/booksearch
CHAT_MODEL=gpt-4.1-mini
# Used only when a request enables AI-as-judge evaluation.
JUDGE_MODEL=gpt-4.1-mini
# Generates up to two alternative retrieval queries for each chat question.
QUERY_REWRITE_ENABLED=true
QUERY_REWRITE_MODEL=gpt-4.1-mini
# Reranks the strongest RRF candidates before they are sent to the answer model.
RERANK_ENABLED=true
RERANK_MODEL=gpt-4.1-mini
RERANK_CANDIDATE_COUNT=20
EMBEDDING_MODEL=text-embedding-3-small
PDF_DIRECTORY=data/pdfs
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
RETRIEVAL_K=5
